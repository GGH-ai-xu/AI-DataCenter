# Required when you start backend manually.
# The Windows launchers auto-generate and inject a stable local key.
GPU_GOV_MASTER_KEY=replace-with-a-stable-random-secret

# Default local agent bootstrap target
AGENT_URL=http://127.0.0.1:8001

# Optional runtime and storage overrides
DB_PATH=./data/history.db
COLLECT_INTERVAL=2

# Alert thresholds
ALERT_TEMP_THRESHOLD=85
ALERT_POWER_THRESHOLD=320
ALERT_MEMORY_THRESHOLD=90

# Power budget governance
POWER_BUDGET_ENABLED=false
POWER_BUDGET_WATTS=1200

# Optional LLM configuration (OpenAI-compatible)
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
